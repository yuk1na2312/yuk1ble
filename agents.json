{
  "codex": {
    "command": "codex",
    "flags": ["--dangerously-bypass-approvals-and-sandbox"],
    "cwdFlag": "--cd",
    "cwdFlagAliases": ["-C"],
    "readyMarkers": ["OpenAI Codex"],
    "inputMethod": "pasteFromFile",
    "gates": [
      {
        "name": "trust prompt",
        "pattern": "Do you trust the contents of this directory\\?|Quick safety check:|Yes, I trust this folder",
        "keys": ["Enter"]
      },
      {
        "name": "codex hooks review",
        "pattern": "Hooks? needs? review|hooks? (?:are|is) new or changed",
        "keys": ["3"],
        "literal": true,
        "trustKeys": ["2"],
        "trustEnv": "ENSEMBLE_CODEX_TRUST_HOOKS"
      }
    ],
    "usagePatterns": [
      { "pattern": "(\\d+)%\\s*left", "format": "$1% budget left" }
    ],
    "stripEnv": ["^OPENAI_(API_KEY|BASE_URL|ORGANIZATION)$"],
    "account": {
      "args": ["login", "status"],
      "text": {
        "signedOut": "not logged in",
        "signedIn": "logged in",
        "account": ["([\\w.+-]+@[\\w-]+\\.[\\w.-]+)", "logged in using\\s+([^(\\n]+?)(?:\\s+account\\b|\\s+-\\s|\\s*$)"],
        "plan": ["\\(([^)]+)\\)"]
      }
    },
    "modelFlag": "--model",
    "models": [{ "id": "gpt-5.6-sol", "label": "Sol" }],
    "color": "#6aa9ff",
    "icon": "◆"
  },
  "claude": {
    "command": "claude",
    "flags": ["--permission-mode", "auto"],
    "addDirFlag": "--add-dir",
    "readyMarkers": ["❯", "? for shortcuts"],
    "inputMethod": "sendKeys",
    "gates": [
      {
        "name": "trust prompt",
        "pattern": "Do you trust the contents of this directory\\?|Quick safety check:|Yes, I trust this folder",
        "keys": ["Enter"]
      },
      {
        "name": "bypass permissions warning",
        "pattern": "WARNING: Claude Code running in Bypass Permissions mode",
        "keys": ["Down"],
        "enter": true
      }
    ],
    "usagePatterns": [
      { "pattern": "(\\d+(?:\\.\\d+)?k)\\s*tokens", "format": "~$1 tokens" },
      { "pattern": "([\\d,]+)\\s*tokens", "format": "~$1 tokens" }
    ],
    "stripEnv": [
      "^ANTHROPIC_(API_KEY|AUTH_TOKEN|BASE_URL)$",
      "^CLAUDE_CODE_",
      "^CLAUDECODE$",
      "^CLAUDE_(PID|EFFORT)$"
    ],
    "account": {
      "args": ["auth", "status", "--json"],
      "json": {
        "signedIn": ["loggedIn", "authenticated", "signedIn", "isAuthenticated"],
        "account": ["email", "account", "user", "username"],
        "plan": ["subscriptionType", "plan", "subscription", "tier"]
      }
    },
    "modelFlag": "--model",
    "models": [
      { "id": "fable", "label": "Fable 5" },
      { "id": "opus", "label": "Opus 5" },
      { "id": "sonnet", "label": "Sonnet 5" }
    ],
    "color": "#7ec98f",
    "icon": "●"
  },
  "aider": {
    "command": "aider",
    "flags": [],
    "readyMarkers": ["❯"],
    "inputMethod": "sendKeys",
    "account": { "unsupported": "aider has no CLI-queryable account status." },
    "color": "#c99ae3",
    "icon": "▲"
  },
  "gemini": {
    "command": "gemini",
    "flags": ["--yolo"],
    "readyMarkers": ["Type your message"],
    "inputMethod": "pasteFromFile",
    "stripEnv": ["^(GEMINI|GOOGLE)_API_KEY$"],
    "account": { "unsupported": "No CLI-queryable auth status — sign in via /auth inside the interactive gemini TUI." },
    "color": "#e3c07b",
    "icon": "★"
  },
  "opencode": {
    "command": "opencode",
    "flags": [],
    "readyMarkers": ["Ask anything"],
    "inputMethod": "sendKeys",
    "account": { "unsupported": "opencode has no CLI-queryable account status." },
    "color": "#6ed4d0",
    "icon": "▣"
  }
}
