{
  "name": "ensemble-win",
  "version": "1.0.0",
  "description": "Multi-agent collaboration engine for native Windows — AI agents that work as one",
  "private": true,
  "type": "module",
  "bin": {
    "ensemble": "bin/ensemble.cjs"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "monitor": "tsx cli/monitor.ts --latest",
    "cli": "tsx cli/ensemble.ts",
    "postinstall": "node ./bin/postinstall.cjs"
  },
  "keywords": [
    "ai", "agents", "multi-agent", "collaboration",
    "claude", "codex", "windows", "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": ["win32"],
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "tsx": "^4.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
