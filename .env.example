# ensemble - environment variables. Copy to .env and adjust.
# Every line is optional; the value shown is the default.

# --- Server -------------------------------------------------------------
ENSEMBLE_PORT=23000
# Loopback by design: the API has no authentication.
ENSEMBLE_HOST=127.0.0.1
# Where the CLI looks for the server.
ENSEMBLE_URL=http://localhost:23000
# Comma-separated allowed CORS origins. Unset = localhost only.
# ENSEMBLE_CORS_ORIGIN=

# --- Data ---------------------------------------------------------------
# Team registry and message feed.
# ENSEMBLE_DATA_DIR=~/.ensemble
# Per-team collab artifacts (messages.jsonl, bridge.pid, prompts/, delivery/).
# ENSEMBLE_RUNTIME_DIR=%TEMP%\ensemble
# Alternative path to the agent program config.
# ENSEMBLE_AGENTS_CONFIG=./agents.json
# Cosmetic label stamped on created teams.
# ENSEMBLE_CREATED_BY=

# --- Agent sessions -----------------------------------------------------
# Shell binary for PTY sessions. Default: pwsh.exe, else powershell.exe. Never cmd.exe.
# ENSEMBLE_SHELL=
# Extra flags appended to every spawned agent CLI.
# ENSEMBLE_AGENT_FLAGS=
# How long to wait for a spawned agent CLI to reach its input prompt (ms).
ENSEMBLE_READY_TIMEOUT_MS=150000
# Answer Codex's "Hooks need review" gate with "Trust all" (1). Default: continue without trusting.
# ENSEMBLE_CODEX_TRUST_HOOKS=1

# --- Lifecycle ----------------------------------------------------------
# Silence before a team auto-disbands (ms). The <<COLLAB_DONE>> sentinel ends a run sooner.
ENSEMBLE_IDLE_DISBAND_MS=3600000
# Idle time before the watchdog nudges an agent (ms), then before it is marked stalled (ms).
# ENSEMBLE_WATCHDOG_NUDGE_MS=90000
# ENSEMBLE_WATCHDOG_STALL_MS=180000
# Grace window before the collab bridge is tree-killed on disband (ms).
# ENSEMBLE_BRIDGE_STOP_GRACE_MS=1500
