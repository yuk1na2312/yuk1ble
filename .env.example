# Copy to .env. Every value below is a default — an empty .env is valid.
# Reference table with full explanations: AGENTS.md § Environment variables.

# --- server / client ---
ENSEMBLE_PORT=23000
ENSEMBLE_URL=http://localhost:23000
# Team + message state. Default: %USERPROFILE%\.ensemble
# ENSEMBLE_DATA_DIR=
# Comma-separated allowed origins. Default: localhost only.
# ENSEMBLE_CORS_ORIGIN=

# --- PTY runtime ---
# Shell binary for agent sessions. pwsh.exe if present, else powershell.exe.
# Never cmd.exe — weak VT support and painful quoting.
# ENSEMBLE_SHELL=pwsh.exe
# Per-team collab artifacts. Default: %TEMP%\ensemble
# ENSEMBLE_RUNTIME_DIR=
ENSEMBLE_BRIDGE_STOP_GRACE_MS=1500

# --- agent startup ---
# Time allowed for a spawned agent CLI to reach its input prompt. 60s is not
# enough for a Claude Code with a heavy MCP/hook stack.
ENSEMBLE_READY_TIMEOUT_MS=150000
# Extra flags appended to every spawned agent CLI.
# ENSEMBLE_AGENT_FLAGS=
# 1 answers Codex's "Hooks need review" gate with "Trust all". Unset answers
# "Continue without trusting" — ensemble must not authorize unreviewed hook
# code while running unattended.
# ENSEMBLE_CODEX_TRUST_HOOKS=

# --- liveness / lifecycle ---
ENSEMBLE_WATCHDOG_NUDGE_MS=90000
ENSEMBLE_WATCHDOG_STALL_MS=180000
# Silence before a team auto-disbands (floor 60s). Only the explicit
# <<COLLAB_DONE>> sentinel or a manual disband ends a run sooner.
ENSEMBLE_IDLE_DISBAND_MS=3600000

# --- optional notifications (leave unset to disable) ---
# ENSEMBLE_TELEGRAM_BOT_TOKEN=
# ENSEMBLE_TELEGRAM_CHAT_ID=
